<Window x:Class="UpominacNarozenin.OsobaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UpominacNarozenin"
        mc:Ignorable="d"
        Title="Přidat osobu" Height="332" Width="300" Icon="/osoba_pridat.ico" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Ilustrační obrázek formuláře. -->
        <Image Source="/osoba_pridat.png" Stretch="None" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" />

        <!-- Popisky používají podtržené písmeno jako klávesovou zkratku. -->
        <Label Content="_Jméno" Grid.Column="0" Grid.Row="1"
               Target="{Binding ElementName=jmenoTextBox}" />
        <Label Content="_Datum narození" Grid.Column="0" Grid.Row="2"
               Target="{Binding ElementName=narozeninyDatePicker}" />
        <TextBox Grid.Column="1" Grid.Row="1" Name="jmenoTextBox" Margin="0,0,0,5" />
        <DatePicker Grid.Column="1" Grid.Row="2" Name="narozeninyDatePicker" Margin="0,0,0,5" />

        <!-- Potvrzení uloží osobu a zavře dialog. -->
        <Button Name="okButton" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"
                HorizontalAlignment="Center" Width="100" VerticalAlignment="Bottom"
                Content="OK" IsDefault="True" Click="OkButton_Click" />
    </Grid>
</Window>
